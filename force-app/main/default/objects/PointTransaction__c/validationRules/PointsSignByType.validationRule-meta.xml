<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PointsSignByType</fullName>
    <active>true</active>
    <description>付与はプラス、利用はマイナスのポイント数にする</description>
    <errorConditionFormula>OR(
  AND(ISPICKVAL(Type__c, &quot;Earn&quot;), Points__c &lt;= 0),
  AND(ISPICKVAL(Type__c, &quot;Use&quot;), Points__c &gt;= 0)
)</errorConditionFormula>
    <errorDisplayField>Points__c</errorDisplayField>
    <errorMessage>付与のときはプラス、利用のときはマイナスのポイント数を入れてください。</errorMessage>
</ValidationRule>
