<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NoNegativeBalance</fullName>
    <active>true</active>
    <description>残高がマイナスになる利用はできない</description>
    <errorConditionFormula>AND(
  ISNEW(),
  ISPICKVAL(Type__c, &quot;Use&quot;),
  PointCard__r.Balance__c + Points__c &lt; 0
)</errorConditionFormula>
    <errorDisplayField>Points__c</errorDisplayField>
    <errorMessage>ポイント残高が足りません。残高より多いポイントは利用できません。</errorMessage>
</ValidationRule>
