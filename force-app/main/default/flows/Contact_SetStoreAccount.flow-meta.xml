<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>SetStoreAccount</name>
        <label>店舗の取引先を入れる</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GetStoreAccount.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>D_CanMove</name>
        <label>店舗の取引先に紐づけてよいか</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>いいえ（法人の担当者など）</defaultConnectorLabel>
        <rules>
            <name>CanMove</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>GetStoreAccount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fCurrentIsStore</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetStoreAccount</targetReference>
            </connector>
            <label>はい</label>
        </rules>
    </decisions>
    <description>#11 個人のお客様（会員）を、よく行く店舗の取引先（取引先区分＝自社店舗）に紐づける。取引先が空欄か、今の取引先が店舗のときだけ動く（法人の担当者は動かさない）</description>
    <environments>Default</environments>
    <formulas>
        <name>fCurrentIsStore</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Account.CustomerCategory__c}, &quot;OwnStore&quot;)</expression>
    </formulas>
    <interviewLabel>取引先責任者：店舗の取引先に紐づけ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>取引先責任者：店舗の取引先に紐づけ</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetStoreAccount</name>
        <label>店舗の取引先を探す</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>D_CanMove</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CustomerCategory__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>OwnStore</stringValue>
            </value>
        </filters>
        <filters>
            <field>Store__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Store__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetStoreAccount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Store__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
