<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>SetExisting</name>
        <label>アップセルにする</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Existing Business</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>D_StoreBlank</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetNew</name>
        <label>新規開拓にする</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>New Business</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>D_StoreBlank</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetAccountStore</name>
        <label>取引先の担当店舗を入れる</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Store__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fAccountStore</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>D_HasWon</name>
        <label>受注済みの商談があるか</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetNew</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>ない</defaultConnectorLabel>
        <rules>
            <name>HasWon</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetWonOpportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetExisting</targetReference>
            </connector>
            <label>ある</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_StoreBlank</name>
        <label>店舗が空欄で、取引先に担当店舗があるか</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>いいえ</defaultConnectorLabel>
        <rules>
            <name>StoreBlank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Store__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fAccountStore</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetAccountStore</targetReference>
            </connector>
            <label>はい</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_TypeBlank</name>
        <label>種別が空欄か</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>D_StoreBlank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>入っている</defaultConnectorLabel>
        <rules>
            <name>TypeBlank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetWonOpportunity</targetReference>
            </connector>
            <label>空欄</label>
        </rules>
    </decisions>
    <description>#10 商談を作るとき (1) 種別が空欄なら、取引先に受注済みの商談があれば「アップセル」、無ければ「新規開拓」にする (2) 店舗が空欄なら取引先の担当店舗を入れる（「商談：店舗の初期値」より先に動く）</description>
    <environments>Default</environments>
    <formulas>
        <name>fAccountStore</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Account.Store__c})</expression>
    </formulas>
    <interviewLabel>商談：営業区分と担当店舗 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>商談：営業区分と担当店舗</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetWonOpportunity</name>
        <label>受注済みの商談を探す</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>D_HasWon</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsWon</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>D_TypeBlank</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>10</triggerOrder>
</Flow>
