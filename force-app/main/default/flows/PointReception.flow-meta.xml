<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <choices>
        <name>ChEarn</name>
        <choiceText>付与（購入金額からポイントを付ける）</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Earn</stringValue>
        </value>
    </choices>
    <choices>
        <name>ChUse</name>
        <choiceText>利用（ポイントを使う）</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Use</stringValue>
        </value>
    </choices>
    <decisions>
        <name>D_Found</name>
        <label>カードが見つかったか</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>S_NotFound</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>見つからない</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCard</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>S_Input</targetReference>
            </connector>
            <label>見つかった</label>
        </rules>
    </decisions>
    <description>#6 店頭でカード番号を読み取り、ポイントを付与・利用する（100円で1ポイント）</description>
    <dynamicChoiceSets>
        <name>StoreChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
        <object xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
        <picklistField>Store__c</picklistField>
        <picklistObject>PointTransaction__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fPoints</name>
        <dataType>Number</dataType>
        <expression>IF({!TypeChoice} = &quot;Earn&quot;, FLOOR(BLANKVALUE({!PurchaseAmountInput}, 0) / 100), -1 * BLANKVALUE({!UsePointsInput}, 0))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fStore</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!StorePick}), TEXT({!$User.Store__c}), {!StorePick})</expression>
    </formulas>
    <formulas>
        <name>fTypeLabel</name>
        <dataType>String</dataType>
        <expression>IF({!TypeChoice} = &quot;Earn&quot;, &quot;付与&quot;, &quot;利用&quot;)</expression>
    </formulas>
    <interviewLabel>ポイント受付 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ポイント受付</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>CreateTx</name>
        <label>ポイント履歴を作る</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetCardAfter</targetReference>
        </connector>
        <faultConnector>
            <targetReference>S_Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>PointCard__c</field>
            <value>
                <elementReference>varCard.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Points__c</field>
            <value>
                <elementReference>fPoints</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PurchaseAmount__c</field>
            <value>
                <elementReference>PurchaseAmountInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Store__c</field>
            <value>
                <elementReference>fStore</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TransactionDate__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type__c</field>
            <value>
                <elementReference>TypeChoice</elementReference>
            </value>
        </inputAssignments>
        <object>PointTransaction__c</object>
    </recordCreates>
    <recordLookups>
        <name>GetCard</name>
        <label>カードを探す</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>D_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CardNumber__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CardNumberInput</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PointCard__c</object>
        <outputReference>varCard</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CardNumber__c</queriedFields>
        <queriedFields>MemberName__c</queriedFields>
        <queriedFields>Balance__c</queriedFields>
        <queriedFields>Status__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>GetCardAfter</name>
        <label>新しい残高を取る</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>S_Done</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCard.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PointCard__c</object>
        <outputReference>varCardAfter</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Balance__c</queriedFields>
    </recordLookups>
    <screens>
        <name>S_Card</name>
        <label>カード番号</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>GetCard</targetReference>
        </connector>
        <fields>
            <name>CardNumberInput</name>
            <dataType>String</dataType>
            <fieldText>カード番号</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;バーコードリーダーで読み取ると、番号が入ります&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
        </fields>
        <nextOrFinishButtonLabel>次へ</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>S_Done</name>
        <label>完了</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>DoneText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!varCard.MemberName__c}&lt;/b&gt; 様のポイントを{!fTypeLabel}しました。&lt;/p&gt;&lt;p&gt;今回：{!fPoints} ポイント&lt;/p&gt;&lt;p&gt;&lt;b&gt;新しい残高：{!varCardAfter.Balance__c} ポイント&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>終了</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>S_Error</name>
        <label>エラー</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ErrorText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;登録できませんでした。&lt;/b&gt;「前へ」で戻って入力を直してください。&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>S_Input</name>
        <label>付与・利用</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>CreateTx</targetReference>
        </connector>
        <fields>
            <name>MemberText</name>
            <fieldText>&lt;p&gt;会員：&lt;b&gt;{!varCard.MemberName__c}&lt;/b&gt; 様（カード番号 {!varCard.CardNumber__c}）&lt;/p&gt;&lt;p&gt;現在の残高：&lt;b&gt;{!varCard.Balance__c} ポイント&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>TypeChoice</name>
            <choiceReferences>ChEarn</choiceReferences>
            <choiceReferences>ChUse</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>ChEarn</defaultSelectedChoiceReference>
            <fieldText>区分</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>PurchaseAmountInput</name>
            <dataType>Currency</dataType>
            <fieldText>購入金額（円）</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;100円で1ポイント付与します&lt;/p&gt;</helpText>
            <isRequired>false</isRequired>
            <scale>0</scale>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>TypeChoice</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Earn</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>UsePointsInput</name>
            <dataType>Number</dataType>
            <fieldText>利用ポイント</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>TypeChoice</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Use</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>StorePick</name>
            <choiceReferences>StoreChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>店舗（空欄なら自分の所属店舗）</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>登録</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>S_NotFound</name>
        <label>カードが見つからない</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NotFoundText</name>
            <fieldText>&lt;p&gt;カード番号「{!CardNumberInput}」のカードは見つかりませんでした。「前へ」で戻って番号を確かめてください。&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>S_Card</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varCard</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PointCard__c</objectType>
    </variables>
    <variables>
        <name>varCardAfter</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PointCard__c</objectType>
    </variables>
</Flow>
