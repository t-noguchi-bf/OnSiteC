<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>D_HasCampaign</name>
        <label>キャンペーンがあるか</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>ない</defaultConnectorLabel>
        <rules>
            <name>HasCampaign</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Campaign__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetMember</targetReference>
            </connector>
            <label>ある</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_MemberFound</name>
        <label>案内した会員か</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>案内していない</defaultConnectorLabel>
        <rules>
            <name>MemberFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetMember</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetRespondedStatus</targetReference>
            </connector>
            <label>案内した</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_StatusFound</name>
        <label>反応ありの状況があるか</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>ない</defaultConnectorLabel>
        <rules>
            <name>StatusFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetRespondedStatus</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateMember</targetReference>
            </connector>
            <label>ある</label>
        </rules>
    </decisions>
    <description>#7 ポイント付与のあと (1) 同じカードの30日以内のキャンペーン購入を「リピート」にする (2) キャンペーンで案内した会員なら、キャンペーンメンバーを「反応あり」の状況にする</description>
    <environments>Default</environments>
    <formulas>
        <name>fDateMinus30</name>
        <dataType>Date</dataType>
        <expression>{!$Record.TransactionDate__c} - 30</expression>
    </formulas>
    <formulas>
        <name>fRespondedStatus</name>
        <description>CampaignMemberStatus.Label は翻訳後の表示ラベルを返すため、標準の「レスポンスあり」は内部の値 Responded に戻す</description>
        <dataType>String</dataType>
        <expression>IF({!GetRespondedStatus.Label} = &quot;レスポンスあり&quot;, &quot;Responded&quot;, {!GetRespondedStatus.Label})</expression>
    </formulas>
    <interviewLabel>ポイント履歴：リピートと反応の記録 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ポイント履歴：リピートと反応の記録</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetMember</name>
        <label>キャンペーンメンバーを探す</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>D_MemberFound</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3) AND 4</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PointCard__r.Member__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Campaign__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Campaign__r.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>HasResponded</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CampaignMember</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>CampaignId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetRespondedStatus</name>
        <label>反応ありの状況を探す</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>D_StatusFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetMember.CampaignId</elementReference>
            </value>
        </filters>
        <filters>
            <field>HasResponded</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CampaignMemberStatus</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Label</queriedFields>
        <sortField>SortOrder</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>UpdateMember</name>
        <label>キャンペーンメンバーを反応ありにする</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetMember.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>fRespondedStatus</elementReference>
            </value>
        </inputAssignments>
        <object>CampaignMember</object>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateRepeats</name>
        <label>30日以内のキャンペーン購入をリピートにする</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>D_HasCampaign</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PointCard__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PointCard__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Campaign__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>RepeatWithin30Days__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Earn</stringValue>
            </value>
        </filters>
        <filters>
            <field>TransactionDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>fDateMinus30</elementReference>
            </value>
        </filters>
        <filters>
            <field>TransactionDate__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>$Record.TransactionDate__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>RepeatWithin30Days__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>PointTransaction__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>UpdateRepeats</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Earn</stringValue>
            </value>
        </filters>
        <object>PointTransaction__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
